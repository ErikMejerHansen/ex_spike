hub_device = KinoWebBluetooth.device("ble-spike-hub")
```

## A small helper

The hub receives messages on its RX characteristic and sends messages on
its TX characteristic. `Hub` sends an ExSPIKE message and waits for the
reply.

ExSPIKE is stateless, so the helper keeps the bytes of an unfinished
frame in its receive loop and hands them back to `ExSPIKE.decode_stream/1`
with the next notification.

```elixir
defmodule Hub do
  @service "0000fd02-0000-1000-8000-00805f9b34fb"
  @rx "0000fd02-0001-1000-8000-00805f9b34fb"
  @tx "0000fd02-0002-1000-8000-00805f9b34fb"

  defstruct [:rx, :tx, max_packet_size: 20]

  @doc "Finds the hub's RX and TX characteristics on a connected device."
  def new(device) do
    :ok = KinoWebBluetooth.await_connected(device)

    %Hub{
      rx: KinoWebBluetooth.characteristic!(device, @service, @rx),
      tx: KinoWebBluetooth.characteristic!(device, @service, @tx)
    }
  end

  @doc "Encodes a message (a struct or raw bytes) and writes it to the hub."
  def send_message(%Hub{} = hub, message) do
    message
    |> ExSPIKE.encode()
    |> ExSPIKE.Frame.packets(hub.max_packet_size)
    |> Enum.each(fn packet ->
      :ok = KinoWebBluetooth.write(hub.rx, packet, with_response: false)
    end)
  end

  @doc "Sends a message and waits for a reply of the given struct type."
  def request(%Hub{} = hub, message, reply_type, timeout \\ 5_000) do
    :ok = KinoWebBluetooth.subscribe(hub.tx)

    try do
      send_message(hub, message)
      await(hub.tx, reply_type, <<>>, timeout)
    after
      KinoWebBluetooth.unsubscribe(hub.tx)
      flush(hub.tx)
    end
  end

  defp await(tx, reply_type, buffer, timeout) do
    receive do
      {:kino_web_bluetooth, :notification, ^tx, bytes} ->
        {results, rest} = ExSPIKE.decode_stream(buffer <> bytes)

        case Enum.find(results, &match?({:ok, %{__struct__: ^reply_type}}, &1)) do
          {:ok, reply} -> {:ok, reply}
          nil -> await(tx, reply_type, rest, timeout)
        end
    after
      timeout -> {:error, :timeout}
    end
  end

  defp flush(tx) do
    receive do
      {:kino_web_bluetooth, :notification, ^tx, _bytes} -> flush(tx)
    after
      0 -> :ok
    end
  end
end

hub = Hub.new(hub_device)
```

## Ask the hub about itself

Always send an `InfoRequest` first. The reply tells us the largest packet
the hub accepts and the largest chunk for file transfers.

```elixir
alias ExSPIKE.{Message, Messages}

{:ok, info} = Hub.request(hub, Messages.info_request(), Message.InfoResponse)
hub = %{hub | max_packet_size: info.max_packet_size}

info
```

```elixir
{:ok, %Message.GetHubNameResponse{name: name}} =
  Hub.request(hub, Messages.get_hub_name(), Message.GetHubNameResponse)

name
```

Messages can also be written as raw bytes. `0x1A` is a `DeviceUuidRequest`:

```elixir
{:ok, %Message.DeviceUuidResponse{uuid: uuid}} =
  Hub.request(hub, <<0x1A>>, Message.DeviceUuidResponse)

Base.encode16(uuid)
```

## Watch what the hub sends

This cell listens to everything the hub sends, in the background. Console
output from programs appears on the left, and sensor and motor readings
on the right.

```elixir
console = Kino.Frame.new()
sensors = Kino.Frame.new()

hub.tx
|> KinoWebBluetooth.stream()
|> Stream.transform(<<>>, fn bytes, buffer ->
  {results, rest} = ExSPIKE.decode_stream(buffer <> bytes)
  {for({:ok, message} <- results, do: message), rest}
end)
|> Kino.listen(fn
  %Message.ConsoleNotification{text: text} ->
    Kino.Frame.append(console, Kino.Text.new(text))

  %Message.DeviceNotification{messages: devices} ->
    Kino.Frame.render(sensors, Kino.Tree.new(devices))

  _other ->
    :ok
end)

Kino.Layout.grid([console, sensors], columns: 2, boxed: true)
```

Ask the hub to send its sensor and motor readings twice a second. Plug in
a motor or sensor and watch the readings above change.

```elixir
Hub.request(hub, Messages.device_notifications(500), Message.DeviceNotificationResponse)
```

## Upload and run a program

This uploads a MicroPython program to a slot and starts it. Its `print`
output shows up in the console above.

> This replaces the program stored in the slot.

```elixir
slot = 0

program = """
import runloop
from hub import light_matrix

print("Hello from Elixir")

async def main():
    await light_matrix.write("Hi!")

runloop.run(main())
"""

# The slot may already be empty, so any reply is fine here
{:ok, _} = Hub.request(hub, Messages.clear_slot(slot), Message.ClearSlotResponse)

upload = Messages.start_file_upload("program.py", slot, ExSPIKE.CRC.crc32(program))

{:ok, %{status: :acknowledged}} =
  Hub.request(hub, upload, Message.StartFileUploadResponse)

for chunk <- Messages.transfer_chunks(program, info.max_chunk_size) do
  {:ok, %{status: :acknowledged}} =
    Hub.request(hub, chunk, Message.TransferChunkResponse)
end

Hub.request(hub, Messages.start_program(slot), Message.ProgramFlowResponse)
```

Stop the program:

```elixir
Hub.request(hub, Messages.stop_program(slot), Message.ProgramFlowResponse)
```

## Clean up

Turn off the sensor readings. Use **Disconnect** in the Smart Cell to
release the hub.

```elixir
Hub.request(hub, Messages.device_notifications(0), Message.DeviceNotificationResponse)
```
